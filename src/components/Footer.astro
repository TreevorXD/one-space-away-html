---
import { SITE } from "@consts";
const currentYear = new Date().getFullYear();
---

<footer class="main-footer">
    <div class="section-container footer footer-primary">
        <div class="footer-brand">
            <a href="/" class="headline logo" aria-label="Victoria Water Polo Club home">Victoria Water Polo Club</a>
            <p class="site-description">{SITE.DESCRIPTION}</p>
            <address class="contact-info">
                <p><span class="label">E.</span> <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a></p>
            </address>
        </div>
        <nav class="footer-navigation" aria-label="Footer navigation">
            <h2 class="headline footer-heading">Explore</h2>
            <ul class="footer-nav-list">
                <li><a href="#hero" class="footer-link">Home</a></li>
                <li><a href="#about" class="footer-link">About</a></li>
                <li><a href="#faq" class="footer-link">FAQ</a></li>
                <li><a href="#contact" class="footer-link">Contact</a></li>
            </ul>
        </nav>
    </div>
    <div class="footer footer-secondary">
        <p>&copy; {SITE.COMPANY_NAME} {currentYear}.</p>
        <p>Based in Victoria, BC.</p>
    </div>
</footer>

<style>
    a { transition: all var(--transition-short); }
    .main-footer { background-color: var(--color-background); padding-block: var(--px-112) var(--px-28); padding-inline: var(--px-64); color: var(--color-text-dark); font-size: var(--text-sm); }
    .footer { display: flex; justify-content: space-between; gap: var(--px-48); flex-wrap: wrap; }
    .headline { color: var(--color-text-primary); }
    .footer-primary { margin-bottom: var(--px-112); }
    .logo { display: inline-block; margin-bottom: var(--px-28); font-size: var(--text-xl); font-weight: 700; }
    .site-description { margin-bottom: var(--px-32); max-width: 24rem; }
    .contact-info { font-style: normal; }
    .footer-heading { margin-bottom: var(--px-16); font-size: var(--text-lg); font-weight: 500; }
    .footer-nav-list { display: flex; flex-direction: column; gap: var(--px-8); }
    .footer-secondary { font-weight: 500; }
    @media (hover: hover) and (pointer: fine) { a:hover { color: var(--color-text-primary); } }
    @media screen and (max-width: 64rem) {
        .main-footer { padding-top: var(--px-80); padding-inline: var(--px-28); }
        .footer-primary { margin-bottom: var(--px-48); }
    }
</style>