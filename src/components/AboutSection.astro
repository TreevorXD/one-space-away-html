---
const aboutContent = [
  {
    id: 1,
    title: 'Who We Are',
    text: 'Victoria Water Polo Club started in 2026 as an adult night league. We are here to grow water polo in Victoria and make it easy to jump in.',
  },
  {
    id: 2,
    title: 'Who Can Play',
    text: 'Anyone 16 and older. Whether you have never held a water polo ball or have played for years, there is a place for you in the pool.',
  },
];
---

<section id="about" class="about">
  <div class="section-container">
    <span class="section-tag">OUR STORY</span>
    <h2 class="section-title">Water polo for everyone in Victoria.</h2>
    <div class="about-container">
      {
        aboutContent.map(content => (
          <div class="about-block">
            <h3 class="section-subtitle about-subtitle">{content.title}</h3>
            <p class="about-text">{content.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-container { display: grid; grid-template-columns: 1fr 1fr; gap: var(--px-64); }
  .about-block { max-width: 37.5rem; }
  @media screen and (max-width: 48rem) {
    .about-container { grid-template-columns: 1fr; gap: var(--px-32); }
  }
</style>