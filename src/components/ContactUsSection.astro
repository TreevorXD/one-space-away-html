---
import { SITE } from '@consts';
---

<section id="contact" class="contact">
  <div class="section-container">
    <span class="section-tag">CONTACT US</span>
    <h2 class="section-title">Ready to get in the pool?</h2>
    <div class="contact-grid">
      <address class="contact-info">
        <div>
          <h3 class="contact-subtitle">Register or say hello</h3>
          <a href={`mailto:${SITE.EMAIL}`} class="contact-detail contact-email">{SITE.EMAIL}</a>
          <a href={`mailto:${SITE.EMAIL}`} class="btn btn--primary contact-btn">EMAIL US</a>
        </div>
        <div>
          <h3 class="contact-subtitle">Location</h3>
          <a class="contact-detail" href={`https://maps.google.com/?q=${encodeURIComponent(SITE.ADDRESS)}`}>{SITE.ADDRESS}</a>
          <p class="contact-detail">Saturdays, 6–8pm</p>
        </div>
      </address>
      <div class="contact-map">
        <iframe
          src="https://www.google.com/maps?q=Commonwealth+Pool+Victoria+BC&output=embed"
          title="Map showing Commonwealth Pool, Victoria, BC"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--px-48); }
  .contact-info { display: grid; gap: var(--px-40); align-content: start; font-style: normal; }
  .contact-subtitle { font-size: var(--text-xl); margin-bottom: var(--px-12); font-weight: 500; }
  .contact-detail { display: block; opacity: 0.8; font-size: var(--text-sm); transition: opacity var(--transition-short); }
  .contact-email { margin-bottom: var(--px-24); }
  .contact-btn { display: inline-block; }
  .contact-map iframe { width: 100%; height: 100%; min-height: 28.125rem; }
  @media (hover: hover) and (pointer: fine) { .contact-detail:hover { opacity: 1; } }
  @media (max-width: 48rem) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-map iframe { min-height: 18.75rem; }
  }
</style>